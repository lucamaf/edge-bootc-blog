# Mosquitto MQTT Broker Configuration
# For RTU IoT Sensor Data
#
# Values below are substituted at container startup by entrypoint.sh from
# environment variables (ALLOW_ANONYMOUS, MAX_CONNECTIONS, MAX_KEEPALIVE,
# MAX_QUEUED_MESSAGES, PERSISTENCE). Edit the defaults in entrypoint.sh, not
# the placeholders here.

# Default listener
listener 1883
protocol mqtt

# WebSocket listener
listener 9001
protocol websockets

# Secure listener (if certificates are available)
# listener 8883
# protocol mqtt
# cafile /mosquitto/certs/ca.crt
# certfile /mosquitto/certs/server.crt
# keyfile /mosquitto/certs/server.key

# Persistence
persistence __PERSISTENCE__
persistence_location /mosquitto/data/

# Logging
log_dest file /mosquitto/log/mosquitto.log
log_dest stdout
log_timestamp true
log_type all

# Allow anonymous connections (set to false for production)
allow_anonymous __ALLOW_ANONYMOUS__

# Maximum number of connections
max_connections __MAX_CONNECTIONS__

# Keep alive interval
max_keepalive __MAX_KEEPALIVE__

# Message queue settings
max_queued_messages __MAX_QUEUED_MESSAGES__

# Retain messages settings
retain_available true

# SYS topics
sys_interval 10
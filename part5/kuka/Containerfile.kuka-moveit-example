# tagged as quay.io/luferrar/part5:kuka-moveit-example
#
# Layered on rviz-humble (RoboStack/conda-forge, ROS2 Humble).
#
# Four source repos, three different branches - none of the KUKA repos
# publish conda/RPM packages, so everything KUKA-specific is built from
# source in one colcon workspace:
#   - kroshu/kuka_drivers (branch: humble) - the driver itself
#     (kuka_iiqka_eac_driver, kuka_drivers_core, kuka_driver_interfaces,
#     and the custom ros2_control controllers it needs:
#     kuka_control_mode_handler, kuka_event_broadcaster,
#     joint_group_impedance_controller). humble/master branches exist
#     because upstream tracks ROS2 distros directly; master currently
#     means Jazzy (this project's rviz-tests explored Humble/Kilted/Lyrical
#     RHEL10 paths already, none of which is Jazzy - see ../rviz-tests
#     README - so Humble here reuses this project's most-proven path
#     instead of opening up a fourth, unvalidated ROS2-distro combination).
#   - kroshu/kuka_robot_descriptions (branch: master) - URDF/meshes/moveit
#     configs for all KUKA robot families, plus kuka_mock_hardware_interface
#     (the mock plugin this test actually exercises). Distro-agnostic
#     (source-only xacro/config/launch, no compiled ROS2-version-specific
#     code), hence no per-distro branch, confirmed against upstream.repos
#     in kuka_drivers itself pinning this repo to "master" regardless of
#     which ROS2-distro branch of kuka_drivers is in use.
#   - kroshu/kuka-external-control-sdk (branch: master) - kuka_external_
#     control_sdk, a non-ROS SDK wrapped with a package.xml so colcon can
#     build it; also distro-agnostic for the same reason.
#   - kroshu/examples (branch: humble) - moveit_example itself.
#
# --packages-up-to moveit_example, not a full workspace build: kuka_drivers
# also contains the RSI/FRI/KSS drivers and controllers for KUKA's other
# (industrial/LBR iiwa) product lines, which moveit_example/the iiQKA
# driver don't need and which pull in their own unrelated dependencies -
# --packages-up-to keeps the build scoped to what this test actually
# exercises.
FROM quay.io/luferrar/part5:rviz-humble

# rviz-humble's ros-humble-desktop does not include MoveIt 2 or the
# ros2_control stack.
#
# compilers/cmake/make/ninja/pkg-config: rviz-humble never needed a C/C++
# toolchain - every ROS package in it is a precompiled conda binary. This
# Containerfile is the first one in this project to build ament_cmake
# packages from source (kuka_drivers_core, kuka_resources,
# kuka_external_control_sdk, ...), which link against conda-forge-built
# libraries (rclcpp, hardware_interface, ...). Using conda-forge's own
# "compilers" meta-package (gcc_linux-64/gxx_linux-64 wrapped as CC/CXX via
# its activation scripts) instead of UBI10's system gcc-c++, per
# RoboStack's own documented practice for building from source - avoids a
# libstdc++ ABI mismatch against those conda-forge-built libraries that a
# system compiler wouldn't necessarily match.
RUN micromamba install -y -n ros_env -c conda-forge -c robostack-humble \
    ros-humble-moveit \
    ros-humble-moveit-planners \
    ros-humble-moveit-ros-planning-interface \
    ros-humble-moveit-visual-tools \
    ros-humble-moveit-ros-visualization \
    ros-humble-controller-manager \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-ros2-controllers-test-nodes \
    ros-humble-joint-state-publisher-gui \
    colcon-common-extensions \
    compilers \
    cmake \
    make \
    ninja \
    pkg-config \
    && micromamba clean -y -a \
    && chmod -R a+rX /opt/conda

# kuka_external_control_sdk (the "iiqka" client library) needs grpc++ (its
# CMakeLists.txt does `pkg_check_modules(gRPC REQUIRED grpc++)`) and a
# grpc_cpp_plugin binary at the hardcoded path
# /usr/bin/grpc_cpp_plugin (protobuf_generate()'s PLUGIN argument in
# iiqka/CMakeLists.txt - not configurable). Tried conda-forge's grpc-cpp
# first, but its libprotobuf requirement (<3.22, the whole feedstock has
# lagged behind rebuilding against newer protobuf majors) directly
# conflicts with ros-humble-moveit-visual-tools' own pin (via
# ros2-distro-mutex) to a much newer libprotobuf (5.x/6.x) - protobuf 3.x
# and 5.x/6.x generated code isn't interchangeable, so this isn't a
# version to force past. dnf's grpc-devel (confirmed present for RHEL10 at
# 1.48.4-44.el10_0, same EPEL10 CRB-adjacent repo Containerfile.rviz-
# pointcloud already enables) sidesteps the conflict entirely - nothing
# else in this build touches protobuf/grpc, so there's no ABI-consistency
# reason to prefer conda-forge here the way there was for the C/C++
# compiler itself. grpc-plugins is the RPM subpackage that installs
# grpc_cpp_plugin, and it lands at exactly /usr/bin/grpc_cpp_plugin -
# matching the hardcoded path with no symlink needed. grpc-devel's own
# Requires resolves pkgconfig(protobuf) (i.e. protobuf-devel) automatically
# - but only once CodeReady Builder is actually enabled. protobuf-devel/
# protobuf-compiler (3.19.6, confirmed directly via `dnf repoquery
# --whatprovides` against the actual entitled host) live in
# codeready-builder-for-rhel-10-x86_64-rpms - the full RHEL10 CRB
# entitlement repo, not the same as UBI10's own lighter "CodeReady Builder"
# repo (which this base image already had enabled and which does NOT
# carry these packages, hence the earlier "nothing provides
# pkgconfig(protobuf)" failure despite RHEL10 BaseOS/AppStream entitlement
# passthrough already being active). Same class of issue as CentOS
# Stream 9's `crb enable` step in Containerfile.rviz-centos-kilted -
# CodeReady Builder needs explicit enabling regardless of what other
# entitled repos are already on.
RUN crb enable
RUN dnf remove -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm && dnf install -y \
    git \
    openssl-devel \
    grpc-devel \
    grpc-plugins \
    && dnf clean all

RUN eval "$(micromamba shell hook -s bash)" && micromamba activate ros_env && \
    mkdir -p /opt/kuka_ws/src && cd /opt/kuka_ws/src && \
    git clone --branch humble --depth 1 https://github.com/kroshu/kuka_drivers.git && \
    git clone --branch master --depth 1 https://github.com/kroshu/kuka_robot_descriptions.git && \
    git clone --branch master --depth 1 https://github.com/kroshu/kuka-external-control-sdk.git && \
    git clone --branch humble --depth 1 https://github.com/kroshu/examples.git kuka_examples && \
    cd /opt/kuka_ws && \
    colcon build --packages-up-to moveit_example --cmake-args -DCMAKE_BUILD_TYPE=Release

RUN chmod -R a+rX /opt/kuka_ws

COPY entrypoint.sh /usr/local/bin/entrypoint-kuka.sh
RUN chmod +x /usr/local/bin/entrypoint-kuka.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-kuka.sh"]

# The self-contained mock-hardware entry point, lives in
# kuka_lbr_iisy_moveit_config (not moveit_example itself), and hardcodes
# mode:="mock" internally (via kuka_resources' shared
# fake_hardware_planning_template.launch.py). 
CMD ["ros2", "launch", "kuka_lbr_iisy_moveit_config", \
     "moveit_planning_fake_hardware.launch.py", "robot_model:=lbr_iisy3_r760"]

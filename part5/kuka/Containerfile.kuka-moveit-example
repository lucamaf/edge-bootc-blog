# tagged as quay.io/luferrar/part5:kuka-moveit-example
#
# Tests https://github.com/kroshu/examples' moveit_example (KUKA iiQKA
# driver + MoveIt 2) against this project's RHEL10 RT-kernel setup, without
# real KUKA hardware attached - purely to check whether the driver stack
# itself (kuka_drivers, the RT control_node with its cpu_affinity/
# thread_priority/mlockall options, and MoveIt) builds and runs cleanly on
# RHEL10, using KUKA's own purpose-built mock hardware plugin
# (kuka_mock_hardware_interface, selected via mode:=mock in the URDF) in
# place of the real iiQKA network driver. This validates the ROS2/build/RT
# side of the stack, not real robot communication (RSI/EAC network I/O).
#
# Standalone (CentOS Stream 10 + RoboStack), NOT layered on rviz-humble
# (UBI10-based) - this originally WAS layered on rviz-humble, but that hit
# a real dead end: kuka_external_control_sdk needs grpc++/protobuf
# (pkg_check_modules(gRPC REQUIRED grpc++) in its CMakeLists.txt), and:
#   - conda-forge's own grpc-cpp feedstock is capped at 1.51.1 (confirmed
#     against the actual linux-64 repodata, not just anaconda.org's
#     possibly-stale "latest_version" field), which needs libprotobuf
#     <3.22 - directly incompatible with robostack-humble's own pin (via
#     ros2-distro-mutex) to libprotobuf 5.x/6.x. Protobuf 3.x and 5.x/6.x
#     generated code isn't interchangeable, so this isn't a version to
#     force past.
#   - RHEL10's own protobuf-devel/protobuf-compoiler (3.19.6, which
#     grpc-devel does need) only live behind the FULL RHEL10 CodeReady
#     Builder repo (codeready-builder-for-rhel-10-x86_64-rpms) - confirmed
#     directly on the entitled build host itself. UBI10's own `crb enable`
#     enables a DIFFERENT, narrower repo
#     (codeready-builder-for-ubi-10-x86_64-rpms) that does not carry them -
#     confirmed by running `crb enable` inside an actual UBI10-based
#     container and inspecting the resulting repo list. This is by design
#     (UBI's CRB is a curated subset for UBI application builds, not a
#     mirror of RHEL's full CRB), not a bug workaroundable with more dnf
#     flags.
# Same class of problem this project already hit once before for the
# Kilted image (UBI9's CodeReady Builder naming/availability not matching
# the CentOS Stream/RHEL-proper install guide) - same fix: CentOS Stream
# instead of UBI, where CRB is a normal, unrestricted repo
# (`dnf config-manager --set-enabled crb`, no subscription-manager
# entitlement involved at all). This does mean redoing the base X11/GPU/
# RoboStack setup that rviz-humble normally provides, rather than reusing
# its image directly - see the first several RUN steps below, which
# mirror ../rviz-tests/Containerfile.rviz-humble's own setup on the new
# base.
#
# Four source repos, three different branches - none of the KUKA repos
# publish conda/RPM packages, so everything KUKA-specific is built from
# source in one colcon workspace:
#   - kroshu/kuka_drivers (branch: humble) - the driver itself
#     (kuka_iiqka_eac_driver, kuka_drivers_core, kuka_driver_interfaces,
#     and the custom ros2_control controllers it needs:
#     kuka_control_mode_handler, kuka_event_broadcaster,
#     joint_group_impedance_controller). humble/master branches exist
#     because upstream tracks ROS2 distros directly; master currently
#     means Jazzy (this project's rviz-tests explored Humble/Kilted/Lyrical
#     RHEL10 paths already, none of which is Jazzy - see ../rviz-tests
#     README - so Humble here reuses this project's most-proven path
#     instead of opening up a fourth, unvalidated ROS2-distro combination).
#   - kroshu/kuka_robot_descriptions (branch: master) - URDF/meshes/moveit
#     configs for all KUKA robot families, plus kuka_mock_hardware_interface
#     (the mock plugin this test actually exercises). Distro-agnostic
#     (source-only xacro/config/launch, no compiled ROS2-version-specific
#     code), hence no per-distro branch, confirmed against upstream.repos
#     in kuka_drivers itself pinning this repo to "master" regardless of
#     which ROS2-distro branch of kuka_drivers is in use.
#   - kroshu/kuka-external-control-sdk (branch: master) - kuka_external_
#     control_sdk, a non-ROS SDK wrapped with a package.xml so colcon can
#     build it; also distro-agnostic for the same reason.
#   - kroshu/examples (branch: humble) - moveit_example itself.
#
# --packages-up-to moveit_example, not a full workspace build: kuka_drivers
# also contains the RSI/FRI/KSS drivers and controllers for KUKA's other
# (industrial/LBR iiwa) product lines, which moveit_example/the iiQKA
# driver don't need and which pull in their own unrelated dependencies -
# --packages-up-to keeps the build scoped to what this test actually
# exercises.
FROM quay.io/centos/centos:stream10

# EPEL for glx-utils (glxinfo), used by check-gpu.sh to confirm rendering
# is actually happening on the NVIDIA GPU. crb: needed for
# protobuf-devel/protobuf-compiler (see header comment) - a normal,
# unrestricted repo on CentOS Stream, unlike UBI's own CRB.
RUN dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-$(rpm -E %rhel).noarch.rpm \
    && dnf config-manager --set-enabled crb \
    && dnf clean all

# System libraries needed for Qt's xcb (X11/XWayland) platform plugin, and
# the GL/EGL dispatch layer the NVIDIA driver libraries (mounted in by the
# host's nvidia-container-toolkit hook at runtime) hook into - same
# rationale as ../rviz-tests/Containerfile.rviz-humble. Plus the build
# toolchain and grpc/protobuf/openssl kuka_external_control_sdk needs
# (see header comment) - all straightforward system RPMs here since
# there's no conda-forge-built C++ code on this base to keep ABI-consistent
# with (unlike the rviz-humble/UBI10 attempt, where the ROS2 stack itself
# was conda-forge-built and a system compiler for the KUKA code risked a
# libstdc++ mismatch against it).
RUN dnf install -y \
    ca-certificates \
    curl \
    git \
    mesa-libGL \
    mesa-libEGL \
    libglvnd \
    libglvnd-egl \
    libglvnd-glx \
    libwayland-client \
    libwayland-cursor \
    libwayland-egl \
    libxkbcommon \
    libxcb \
    libX11 \
    libXext \
    libXrender \
    libSM \
    libICE \
    fontconfig \
    dbus-libs \
    glx-utils \
    gcc \
    gcc-c++ \
    make \
    cmake \
    ninja-build \
    pkgconfig \
    openssl-devel \
    grpc-devel \
    grpc-plugins \
    && dnf clean all

# Micromamba (standalone, no system python/conda needed) to install ROS2
# via RoboStack.
ENV MAMBA_ROOT_PREFIX=/opt/conda
RUN curl -fsSL -o /usr/local/bin/micromamba \
    https://github.com/mamba-org/micromamba-releases/releases/latest/download/micromamba-linux-64 \
    && chmod +x /usr/local/bin/micromamba

# ros-base + rviz2 + ros2launch, not the full ros-humble-desktop
# metapackage - moveit_example doesn't touch rqt/demo nodes/turtlesim/
# teleop, same reasoning as ../rviz-tests/Containerfile.rviz-pointcloud.
# Plus MoveIt 2/ros2_control, which ros-base doesn't include either.
RUN micromamba create -y -n ros_env -c conda-forge -c robostack-humble \
    ros-humble-ros-base \
    ros-humble-rviz2 \
    ros-humble-ros2launch \
    ros-humble-moveit \
    ros-humble-moveit-planners \
    ros-humble-moveit-ros-planning-interface \
    ros-humble-moveit-visual-tools \
    ros-humble-moveit-ros-visualization \
    ros-humble-controller-manager \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-ros2-controllers-test-nodes \
    ros-humble-joint-state-publisher-gui \
    colcon-common-extensions \
    && micromamba clean -y -a \
    && chmod -R a+rX /opt/conda

RUN eval "$(micromamba shell hook -s bash)" && micromamba activate ros_env && \
    mkdir -p /opt/kuka_ws/src && cd /opt/kuka_ws/src && \
    git clone --branch humble --depth 1 https://github.com/kroshu/kuka_drivers.git && \
    git clone --branch master --depth 1 https://github.com/kroshu/kuka_robot_descriptions.git && \
    git clone --branch master --depth 1 https://github.com/kroshu/kuka-external-control-sdk.git && \
    git clone --branch humble --depth 1 https://github.com/kroshu/examples.git kuka_examples && \
    cd /opt/kuka_ws && \
    colcon build --packages-up-to moveit_example --cmake-args -DCMAKE_BUILD_TYPE=Release

RUN chmod -R a+rX /opt/kuka_ws

COPY entrypoint.sh /usr/local/bin/entrypoint-kuka.sh
RUN chmod +x /usr/local/bin/entrypoint-kuka.sh

# Writable-by-anyone home so an arbitrary --user UID (see
# ../rviz-tests/run-rviz-test.sh) has somewhere to put Qt/ROS config files.
ENV HOME=/tmp
ENV QT_QPA_PLATFORM=xcb
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV NVIDIA_VISIBLE_DEVICES=all

WORKDIR /opt

ENTRYPOINT ["/usr/local/bin/entrypoint-kuka.sh"]

# The self-contained mock-hardware entry point, lives in
# kuka_lbr_iisy_moveit_config (not moveit_example itself), and hardcodes
# mode:="mock" internally (via kuka_resources' shared
# fake_hardware_planning_template.launch.py). Run one of moveit_example's
# own planning nodes (e.g. `ros2 run moveit_example
# moveit_basic_planners_example`) in a second terminal against this to
# actually exercise motion planning through the stack. For RT-tuned
# testing instead of this convenience default, see the README's "Testing
# RT Performance" section.
CMD ["ros2", "launch", "kuka_lbr_iisy_moveit_config", \
     "moveit_planning_fake_hardware.launch.py", "robot_model:=lbr_iisy3_r760"]

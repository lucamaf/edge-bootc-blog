# tagged as quay.io/luferrar/part5:rviz-lyrical
#
# Fedora + ROS2 Lyrical via the Fedora robotics-sig's hellaenergy/ros2 Copr, per
# https://docs.fedoraproject.org/en-US/robotics-sig/ros2/#_ros_2_lyrical_installation
#
# Native Wayland tested and confirmed NOT to work: QT_QPA_PLATFORM=wayland 
# gets past Qt itself but rviz-ogre-vendor's window creation is still hardcoded to GLX/X11 -
# "RenderingAPIException: Invalid parentWindowHandle (wrong server or
# screen) in GLXWindow::create at .../GLX/OgreGLXWindow.cpp".
FROM registry.fedoraproject.org/fedora:44

RUN dnf install -y dnf-plugins-core \
    && dnf copr enable -y hellaenergy/ros2 \
    && dnf clean all

# yaml-cpp: librviz_common.so links directly against libyaml-cpp.so.0.8
# (confirmed via ldd), but none of the hellaenergy/ros2 Copr's rviz RPMs
# (rviz2, rviz-common, rviz-rendering, rviz-ogre-vendor,
# rviz-default-plugins) declare it as a Requires, so we have to install it explicitly here, otherwise rviz2 fails at runtime
RUN dnf install -y \
    mesa-libGL \
    mesa-libEGL \
    libglvnd \
    libglvnd-egl \
    libglvnd-glx \
    libxkbcommon \
    libxcb \
    libX11 \
    libXext \
    libXrender \
    libSM \
    libICE \
    fontconfig \
    dbus-libs \
    glx-utils \
    yaml-cpp \
    && dnf clean all

# ros-lyrical-std-srvs: rviz2 fails at dlopen with
# "libstd_srvs__rosidl_typesupport_cpp.so: cannot open shared object file"
RUN dnf install -y ros-lyrical-ros-desktop ros-lyrical-std-srvs \
    && dnf clean all

COPY entrypoint-lyrical.sh /usr/local/bin/entrypoint-lyrical.sh
COPY check-gpu.sh /usr/local/bin/check-gpu.sh
RUN chmod +x /usr/local/bin/entrypoint-lyrical.sh /usr/local/bin/check-gpu.sh

ENV HOME=/tmp
ENV QT_QPA_PLATFORM=xcb
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV NVIDIA_VISIBLE_DEVICES=all

WORKDIR /opt

ENTRYPOINT ["/usr/local/bin/entrypoint-lyrical.sh"]
CMD ["rviz2"]
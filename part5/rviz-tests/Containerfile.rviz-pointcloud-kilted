# tagged as quay.io/luferrar/part5:rviz-pointcloud-kilted
#
# gpu_pointcloud_test (../gpu_pointcloud_test/) layered on the official-RPM Kilted image
# (quay.io/luferrar/part5:rviz-kilted) 
#
#  ros-kilted-desktop is already lean via RPMs (6GB vs ros-humble-desktop's 14GB), so there's no
# equivalent "trim to ros-base" win to chase here.
#
FROM quay.io/luferrar/part5:rviz-kilted

# python3-colcon-common-extensions/python3-pip/python3-setuptools are from
# the same official install guide as ros-kilted-desktop itself
# (docs.ros.org's RHEL-Install-RPMs page's "optional dev tools" list).
RUN dnf install -y \
    python3-colcon-common-extensions \
    python3-pip \
    python3-setuptools \
    && dnf clean all

# cupy-cuda12x, with numpy forced past CentOS Stream 9's RPM-packaged
# version (1.23.5, predates the numpy._typing submodule CuPy's code
# imports - silently caught by gpu_backend.py's bare except, surfacing
# only as an unexplained CPU fallback at runtime rather than an import
# error).
#
# Explicitly installing what the "cupy-cuda12x[ctk]" extra actually
# resolves to (checked via PyPI's own package metadata for a recent
# cupy-cuda12x release: cuda-toolkit[cublas,cudart,cufft,curand,cusolver,
# cusparse,nvrtc]==12.* - NVIDIA's unified metapackage, not the older
# individually-named nvidia-cuda-nvrtc-cu12/nvidia-cuda-runtime-cu12
# wheels) rather than relying on the extra itself: on CentOS Stream 9's
# Python 3.9 (RHEL9-vintage, past upstream CPython EOL), pip resolves to
# the last cp39-compatible cupy-cuda12x release (13.6.0), which predates
# the [ctk] extra's introduction entirely - pip printed "does not provide
# the extra 'ctk'" and silently installed plain CuPy with none of the
# bundled CUDA components. Installing just nvidia-cuda-nvrtc-cu12 (the
# compiler .so) got further but then failed on "Failed to auto-detect
# CUDA root directory" - CuPy also needs the headers (cudart) to assemble
# its JIT compile flags, not just the compiler library.
RUN pip3 install --no-cache-dir --upgrade \
    cupy-cuda12x \
    "cuda-toolkit[cublas,cudart,cufft,curand,cusolver,cusparse,nvrtc]==12.*" \
    numpy

COPY gpu_pointcloud_test /opt/gpu_pointcloud_ws/src/gpu_pointcloud_test

RUN source /opt/ros/kilted/setup.bash && \
    cd /opt/gpu_pointcloud_ws && \
    colcon build --packages-select gpu_pointcloud_test

COPY rviz-tests/entrypoint-pointcloud-kilted.sh /usr/local/bin/entrypoint-pointcloud-kilted.sh
RUN chmod +x /usr/local/bin/entrypoint-pointcloud-kilted.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-pointcloud-kilted.sh"]

# Same tuned parameters as the other cases.
CMD ["ros2", "launch", "gpu_pointcloud_test", "gpu_pointcloud.launch.py", \
     "num_points:=200000", "gpu_iterations:=80", "neighbor_sample:=800"]
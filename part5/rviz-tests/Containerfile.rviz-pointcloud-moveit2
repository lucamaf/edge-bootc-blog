# tagged as quay.io/luferrar/part5:rviz-pointcloud-moveit2
#
# gpu_pointcloud_test (../gpu_pointcloud_test/), layered directly on
# MoveIt2's own official Docker image (moveit/moveit2:jazzy-release,
# https://hub.docker.com/r/moveit/moveit2)
#
# moveit/moveit2:jazzy-release is `FROM ros:jazzy-ros-base` (Ubuntu 24.04
# Noble) plus `apt-get install ros-jazzy-moveit-*`, moveit-ros-
# visualization pulls in rviz2 transitively. Jazzy ROS release.
FROM docker.io/moveit/moveit2:jazzy-release

# Same X11/GPU passthrough rationale as the other images.
RUN apt-get update -q && apt-get install -y --no-install-recommends \
    libgl1 \
    libegl1 \
    libglvnd0 \
    libglx0 \
    libxkbcommon0 \
    libxcb1 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libsm6 \
    libice6 \
    libfontconfig1 \
    libdbus-1-3 \
    mesa-utils \
    ros-jazzy-ros2launch \
    python3-colcon-common-extensions \
    python3-pip \
    python3-setuptools \
    && rm -rf /var/lib/apt/lists/*

# --break-system-packages: Ubuntu 24.04's python3-pip enforces PEP 668
# ("externally managed environment") by default, refusing to install into
# the system Python without either a venv or this explicit override -
# fine here since this container has no other Python workload to
# conflict with. --ignore-installed: the base image already has
# python3-numpy installed via apt/dpkg, which has no pip RECORD metadata
# - pip's default --upgrade behavior tries to uninstall it first and fails
# outright ("Cannot uninstall numpy 1.26.4 ... installed by debian"), a
# well-known pip/Debian conflict; --ignore-installed tells pip to install
# fresh over it instead of attempting that uninstall, safe here since
# nothing else in this container depends on the apt-provided numpy.
# NVIDIA's unified cuda-toolkit metapackage rather than trusting
# cupy-cuda12x's own [ctk] extra.
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed --upgrade \
    cupy-cuda12x \
    "cuda-toolkit[cublas,cudart,cufft,curand,cusolver,cusparse,nvrtc]==12.*" \
    numpy

COPY gpu_pointcloud_test /opt/gpu_pointcloud_ws/src/gpu_pointcloud_test

# bash -c : Containerfile RUN steps execute via
# /bin/sh, which on this Ubuntu-based image is dash, not bash - and
# setup.bash's own content uses bash-specific syntax (${BASH_SOURCE[0]}
# array-indexing), which dash can't parse even via the POSIX `.` command
# ("Bad substitution"). Explicitly invoking bash here keeps using
# setup.bash.
RUN bash -c '. /opt/ros/jazzy/setup.bash && \
    cd /opt/gpu_pointcloud_ws && \
    colcon build --packages-select gpu_pointcloud_test'

COPY rviz-tests/entrypoint-pointcloud-moveit2.sh /usr/local/bin/entrypoint-pointcloud-moveit2.sh
COPY rviz-tests/check-gpu.sh /usr/local/bin/check-gpu.sh
RUN chmod +x /usr/local/bin/entrypoint-pointcloud-moveit2.sh /usr/local/bin/check-gpu.sh

# Writable-by-anyone home so an arbitrary --user UID (see
# run-rviz-test.sh) has somewhere to put Qt/ROS config files - the base
# image otherwise defaults to HOME=/root, unwritable by a non-root UID.
ENV HOME=/tmp
ENV QT_QPA_PLATFORM=xcb
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV NVIDIA_VISIBLE_DEVICES=all

WORKDIR /opt

ENTRYPOINT ["/usr/local/bin/entrypoint-pointcloud-moveit2.sh"]

# Same default parameters as the other pointcloud variants' default - see
# ../rviz-tests/README.md's "Test Results" sections for the P620-specific
# reasoning/numbers behind these values.
CMD ["ros2", "launch", "gpu_pointcloud_test", "gpu_pointcloud.launch.py", \
     "num_points:=200000", "gpu_iterations:=80", "neighbor_sample:=800"]

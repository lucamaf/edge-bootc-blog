#This image will be tagged as quay.io/luferrar/part5:device002
#using this as starting point https://gitlab.com/LeoBras/rt-pretuned-bootc/-/blob/main/tuned.containerfile?ref_type=heads
FROM registry.redhat.io/rhel9/rhel-bootc:latest

#Install rt-kernel
RUN dnf config-manager --set-enabled rhel-9-for-x86_64-rt-rpms
RUN rpm-ostree override remove kernel kernel-{core,modules,modules-core} \
   --install kernel-rt-core --install kernel-rt-modules --install kernel-rt-modules-core

#Install tuned & realtime stuff
RUN dnf install -y \
    tuned \
    tuned-profiles-realtime \
    realtime-tests \
    realtime-setup \
    rteval \
    rteval-loads \
    rtla \
    tuna \
    stress-ng \
    tmux \
    && dnf clean all
RUN systemctl enable tuned 

#since we cannot apply tuned during the build we create a systemd unit that will be executed on the first boot and apply tuned profile.
COPY rt-tuning-first-boot.sh /usr/local/sbin/custom-rt-tuning-first-boot.sh 
RUN chmod +x /usr/local/sbin/custom-rt-tuning-first-boot.sh
COPY rt-post-install-tuning.service /usr/lib/systemd/system/rt-post-install-tuning.service
RUN systemctl enable rt-post-install-tuning
RUN systemctl disable irqbalance

#Replacing placeholder in the script with actual profile name
RUN sed -i "s/<profile_name>/${TARGET_PROFILE}/" /usr/local/sbin/custom-rt-tuning-first-boot.sh

#adding arguments for RT kernel
RUN rm /usr/lib/bootc/kargs.d/*.toml ;\
  echo -e "kargs = [\"iommu=pt\"]\nmatch-architectures = [\"x86_64\"]" > /usr/lib/bootc/kargs.d/01-iommu-pt.toml ; \
  echo -e "kargs = [\"intel_iommu=on\"]\nmatch-architectures = [\"x86_64\"]" > /usr/lib/bootc/kargs.d/02-intel-iommu.toml ; \
  echo -e "kargs = [\"default_hugepagesz=1G\"]\nmatch-architectures = [\"x86_64\", \"aarch64\"]" > /usr/lib/bootc/kargs.d/03-hugepage.toml ; \
  echo -e "kargs = [\"idle=poll\"]\nmatch-architectures = [\"x86_64\", \"aarch64\"]" > /usr/lib/bootc/kargs.d/04-idle-pool.toml ; \
  echo -e "kargs = [\"rcutree.nocb_patience_delay=1000\"]\nmatch-architectures = [\"x86_64\", \"aarch64\"]" > /usr/lib/bootc/kargs.d/05-rcu-patience.toml ; \
  echo -e "kargs = [\"console=ttyS1,115200\"]\nmatch-architectures = [\"x86_64\"]" > /usr/lib/bootc/kargs.d/00-console-intel.toml ; \
  echo -e "kargs = [\"console=tty0 console=ttyAMA0,115200n81\"]\nmatch-architectures = [\"aarch64\"]" > /usr/lib/bootc/kargs.d/00-console-arm.toml ;  

ARG RTCPU_LIST=1
#adding in the end so that if we build image for guest and host we can use cache
RUN sed -i "s/^isolated_cores.*/isolated_cores=${RTCPU_LIST}/" /etc/tuned/${TARGET_PROFILE}-variables.conf

# Lint the build
RUN bootc container lint

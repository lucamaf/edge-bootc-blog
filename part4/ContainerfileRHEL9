# In this example, a simple "podman-systemd" unit which runs
# an application container via https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# that is also configured for automatic updates via
# https://docs.podman.io/en/latest/markdown/podman-auto-update.1.html
# tagged as "latest"
FROM registry.redhat.io/rhel9/rhel-bootc:latest

RUN dnf -y group install GNOME && \
    dnf -y install firefox cockpit cockpit-podman mkpasswd && \
    dnf -y clean all

RUN systemctl set-default graphical.target

# adding system user
RUN pass=$(mkpasswd --method=SHA-512 --rounds=4096 R3dH4t!) && useradd -m -G wheel admin -p $pass

# install and enable firewall 
RUN dnf -y install firewalld && \
    dnf -y clean all
RUN firewall-offline-cmd --add-service=cockpit && \
    firewall-offline-cmd --add-service=http && \
    systemctl enable firewalld

# install VLC
RUN dnf -y install https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm && \
    dnf -y install https://download1.rpmfusion.org/free/el/rpmfusion-free-release-9.noarch.rpm && \ 
    dnf -y install https://download1.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-9.noarch.rpm && \
    dnf -y install vlc && \
    dnf -y clean all

# remove unnecessary packages
RUN dnf -y remove gnome-tour gnome-calculator cheese totem avahi-daemon && \
    dnf -y clean all


RUN echo "%wheel        ALL=(ALL)       NOPASSWD: ALL" > /etc/sudoers.d/wheel-sudo

COPY caddy.container /usr/share/containers/systemd
RUN ln -s /usr/share/containers/systemd/caddy.container /usr/lib/bootc/bound-images.d/caddy.container
# Enable the simple "automatic update containers" timer, in the same way
# that there is a simplistic bootc upgrade timer.  However, you can
# obviously also customize this as you like; for example, using
# other tooling like Watchtower or explicit out-of-band control over container
# updates via e.g. Ansible or other custom logic.
RUN systemctl enable podman-auto-update.timer && \
    systemctl enable cockpit.socket